<odoo>
    <record
        id="product_template_form_view_purchase_secondary_uom_visible"
        model="ir.ui.view"
    >
        <field name="name">product.template.purchase.secondary.uom.visible</field>
        <field name="model">product.template</field>
        <field
            name="inherit_id"
            ref="purchase_order_secondary_unit.product_template_form_view"
        />
        <field name="arch" type="xml">
            <xpath
                expr="//page[@name='purchase']/group[@name='purchase']/group[@name='bill']"
                position="after"
            >
                <group
                    name="purchase_secondary_uom_reference"
                    string="Vendor Bills"
                    groups="purchase.group_purchase_user,!purchase.group_purchase_manager"
                >
                    <field
                        name="purchase_secondary_uom_id"
                        options="{'no_create': True}"
                    />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
