<odoo>
    <record id="view_product_supplier_inherit" model="ir.ui.view">
        <field name="name">product.template.purchase.secondary.uom.visible</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="purchase.view_product_supplier_inherit" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='purchase']" position="attributes">
                <attribute
                    name="groups"
                >purchase.group_purchase_user,product.group_product_manager</attribute>
            </xpath>
            <xpath
                expr="//page[@name='purchase']/group[@name='purchase']/group[@name='bill']"
                position="attributes"
            >
                <attribute
                    name="groups"
                >purchase.group_purchase_manager,product.group_product_manager</attribute>
            </xpath>
        </field>
    </record>
</odoo>
