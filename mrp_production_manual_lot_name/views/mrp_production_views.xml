<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="mrp_production_form_view" model="ir.ui.view">
        <field name="name">mrp.production.form.inherit.manual.lot.name</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='lot_producing_id']" position="attributes">
                <attribute name="invisible">
                    product_tracking in ('none', False) or (mrp_manual_lot_name and not lot_producing_id)
                </attribute>
            </xpath>
            <xpath expr="//field[@name='lot_producing_id']" position="after">
                <field name="mrp_manual_lot_name" invisible="1" />
                <field
                    name="lot_producing_name"
                    invisible="product_tracking in ('none', False) or not mrp_manual_lot_name or lot_producing_id"
                />
            </xpath>
            <xpath
                expr="//button[@name='action_generate_serial']"
                position="attributes"
            >
                <attribute name="invisible">
                    product_tracking in ('none', False) or lot_producing_id or (mrp_manual_lot_name and not lot_producing_name)
                </attribute>
            </xpath>
        </field>
    </record>
</odoo>
