<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="purchase_order_form_analytic_plan_account" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.analytic_plan_field</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='order_line']//list//field[@name='analytic_distribution']"
                position="after"
            >
                <field name="analytic_plan_account_id" optional="show" readonly="1" />
            </xpath>
        </field>
    </record>
    <record id="purchase_order_line_tree_analytic_plan_account" model="ir.ui.view">
        <field name="name">purchase.order.line.list.inherit.analytic_plan_field</field>
        <field name="model">purchase.order.line</field>
        <field name="inherit_id" ref="purchase.purchase_order_line_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date_planned']" position="after">
                <field name="analytic_plan_account_id" optional="show" />
            </xpath>
        </field>
    </record>
    <record id="purchase_order_line_search_analytic_plan_account" model="ir.ui.view">
        <field
            name="name"
        >purchase.order.line.search.inherit.analytic_plan_field</field>
        <field name="model">purchase.order.line</field>
        <field name="inherit_id" ref="purchase.purchase_order_line_search" />
        <field name="arch" type="xml">
            <xpath expr="//search/field[@name='partner_id']" position="after">
                <field name="analytic_plan_account_id" />
            </xpath>
            <xpath expr="//filter[@name='group_by_date_order']" position="after">
                <filter
                    name="groupby_analytic_plan_account"
                    string="Analytic Plan Account"
                    domain="[]"
                    context="{'group_by': 'analytic_plan_account_id'}"
                />
            </xpath>
        </field>
    </record>
</odoo>
