<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form_analytic_plan_field" model="ir.ui.view">
        <field
            name="name"
        >res.config.settings.view.form.inherit.analytic_plan_field</field>
        <field name="model">res.config.settings</field>
        <field
            name="inherit_id"
            ref="purchase.res_config_settings_view_form_purchase"
        />
        <field name="arch" type="xml">
            <xpath expr="//app[@name='purchase']" position="inside">
                <block
                    title="Analytic Plan Field"
                    name="analytic_plan_field_setting_container"
                >
                    <setting
                        string="Analytic Plan for Purchase Order Lines"
                        help="Select the analytic plan used for the analytic plan account field on purchase order lines."
                    >
                        <field name="analytic_plan_purchase_order_line_id" />
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
