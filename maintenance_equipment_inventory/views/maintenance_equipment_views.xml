<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="hr_equipment_view_form_inventory" model="ir.ui.view">
        <field name="name">maintenance.equipment.form.inventory</field>
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="%(maintenance_equipment_inventory_record_action)d"
                    type="action"
                    class="oe_stat_button"
                    icon="fa-list-ol"
                    context="{'default_equipment_id': id, 'search_default_equipment_id': id}"
                >
                    <field
                        string="Inventory Records"
                        name="inventory_record_count"
                        widget="statinfo"
                    />
                </button>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Inventory" name="inventory">
                    <group>
                        <group>
                            <field name="last_inventory_date" />
                            <field name="last_inventory_result" />
                        </group>
                    </group>
                    <field
                        name="inventory_record_ids"
                        context="{'default_equipment_id': id}"
                    >
                        <list editable="bottom">
                            <field name="name" />
                            <field
                                name="inventory_date"
                                readonly="state == 'approved'"
                            />
                            <field name="result" readonly="state == 'approved'" />
                            <field
                                name="checked_by_id"
                                readonly="state == 'approved'"
                            />
                            <field name="approved_by_id" />
                            <field
                                name="state"
                                widget="badge"
                                decoration-info="state == 'to_approve'"
                                decoration-success="state == 'approved'"
                            />
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record
        id="maintenance_equipment_create_inventory_record_action"
        model="ir.actions.server"
    >
        <field name="name">Create Inventory Records</field>
        <field name="model_id" ref="maintenance.model_maintenance_equipment" />
        <field name="binding_model_id" ref="maintenance.model_maintenance_equipment" />
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.action_create_inventory_records()</field>
    </record>
</odoo>
