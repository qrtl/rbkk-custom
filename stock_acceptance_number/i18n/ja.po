#. module: stock_acceptance_number
#: model:ir.model.fields,field_description:stock_acceptance_number.field_stock_lot__acceptance_number
#: model:ir.model.fields,field_description:stock_acceptance_number.field_stock_move__acceptance_number
#: model:ir.model.fields,field_description:stock_acceptance_number.field_stock_move_line__acceptance_number
#: model:ir.model.fields,field_description:stock_acceptance_number.field_stock_picking__acceptance_number
msgid "Acceptance Number"
msgstr "受入番号"

#. module: stock_acceptance_number
#: model:ir.model.fields,field_description:stock_acceptance_number.field_stock_lot__acceptance_move_line_ids
msgid "Acceptance Operations"
msgstr "受入オペレーション"

#. module: stock_acceptance_number
#: model:ir.model.fields,help:stock_acceptance_number.field_stock_move_line__acceptance_number
msgid ""
"Acceptance number of this detailed operation. It is the one kept on the lot "
"the goods are received in."
msgstr ""
"この詳細オペレーションの受入番号。入荷先のロットに保持される番号です。"

#. module: stock_acceptance_number
#: model:ir.model.fields,help:stock_acceptance_number.field_stock_lot__acceptance_number
msgid ""
"Acceptance numbers the lot was received under. A lot received several times "
"carries them all, separated by commas."
msgstr ""
"このロットが入荷した際の受入番号。複数回入荷したロットはそのすべてをカンマ区"
"切りで保持します。"

#. module: stock_acceptance_number
#: model:ir.model,name:stock_acceptance_number.model_stock_lot
msgid "Lot/Serial"
msgstr "ロット/シリアル"

#. module: stock_acceptance_number
#: model:ir.model,name:stock_acceptance_number.model_stock_move_line
msgid "Product Moves (Stock Move Line)"
msgstr "プロダクトの移動(在庫移動ライン)"

#. module: stock_acceptance_number
#: model:ir.model.fields,help:stock_acceptance_number.field_stock_lot__acceptance_move_line_ids
msgid ""
"Receipt operations the lot appears in, which the acceptance numbers of the "
"lot are read from."
msgstr ""
"このロットが含まれる入荷の詳細オペレーション。ロットの受入番号はここから取得"
"されます。"

#. module: stock_acceptance_number
#: model:ir.model,name:stock_acceptance_number.model_stock_move
msgid "Stock Move"
msgstr "在庫移動"

#. module: stock_acceptance_number
#: model:ir.model.fields,help:stock_acceptance_number.field_stock_move__acceptance_number
msgid ""
"Summary of the acceptance numbers of the detailed operations of the line. A "
"line of a product without tracking can be numbered here directly; a tracked "
"one is numbered per lot in its detailed operations."
msgstr ""
"この明細の詳細オペレーションの受入番号のまとめ。追跡のないプロダクトの明細は"
"ここで直接入力でき、追跡のあるプロダクトは詳細オペレーションでロットごとに入"
"力します。"

#. module: stock_acceptance_number
#: model:ir.model.fields,help:stock_acceptance_number.field_stock_picking__acceptance_number
msgid "Summary of the acceptance numbers of the lines of the transfer."
msgstr "転送の明細の受入番号のまとめ。"

#. module: stock_acceptance_number
#: model:ir.model,name:stock_acceptance_number.model_stock_picking
msgid "Transfer"
msgstr "転送"
