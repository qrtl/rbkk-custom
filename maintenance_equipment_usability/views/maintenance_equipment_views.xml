<odoo>
    <record id="hr_equipment_view_form" model="ir.ui.view">
        <field name="name">maintenance.equipment.form</field>
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_view_form" />
        <field name="arch" type="xml">
            <field name="category_id" position="after">
                <field name="status" />
                <field name="usability_state" readonly="1" />
            </field>
            <xpath
                expr="//page[@name='maintenance']//group[@name='statistics']"
                position="after"
            >
                <group name="usability" string="Usability">
                    <field name="latest_maintenance_result_request_id" readonly="1" />
                    <field name="latest_maintenance_result_date" readonly="1" />
                </group>
            </xpath>
        </field>
    </record>

    <record id="hr_equipment_view_tree" model="ir.ui.view">
        <field name="name">maintenance.equipment.list</field>
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_view_tree" />
        <field name="arch" type="xml">
            <field name="category_id" position="after">
                <field
                    name="usability_state"
                    widget="badge"
                    decoration-success="usability_state == 'usable'"
                    decoration-danger="usability_state == 'unusable'"
                    decoration-muted="usability_state == 'unknown'"
                    optional="show"
                />
            </field>
        </field>
    </record>

    <record id="hr_equipment_view_kanban" model="ir.ui.view">
        <field name="name">maintenance.equipment.kanban</field>
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_view_kanban" />
        <field name="arch" type="xml">
            <xpath expr="//progressbar[@field='activity_state']" position="after">
                <field name="usability_state" />
            </xpath>
            <xpath
                expr="//div[@t-if='record.maintenance_open_count.raw_value']"
                position="after"
            >
                <div
                    t-if="record.usability_state.raw_value == 'usable'"
                    class="badge text-bg-success"
                >
                    <t t-out="record.usability_state.value" />
                </div>
                <div
                    t-elif="record.usability_state.raw_value == 'unusable'"
                    class="badge text-bg-danger"
                >
                    <t t-out="record.usability_state.value" />
                </div>
                <div
                    t-elif="record.usability_state.raw_value == 'unknown'"
                    class="badge text-bg-secondary"
                >
                    <t t-out="record.usability_state.value" />
                </div>
            </xpath>
        </field>
    </record>

    <record id="hr_equipment_view_search" model="ir.ui.view">
        <field name="name">maintenance.equipment.search</field>
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_view_search" />
        <field name="arch" type="xml">
            <field name="category_id" position="after">
                <field name="usability_state" />
            </field>
            <filter name="under_maintenance" position="after">
                <separator />
                <filter
                    string="Usable"
                    name="usable"
                    domain="[('usability_state', '=', 'usable')]"
                />
                <filter
                    string="Unusable"
                    name="unusable"
                    domain="[('usability_state', '=', 'unusable')]"
                />
                <filter
                    string="Unknown Usability"
                    name="unknown_usability"
                    domain="[('usability_state', '=', 'unknown')]"
                />
            </filter>
        </field>
    </record>
</odoo>
