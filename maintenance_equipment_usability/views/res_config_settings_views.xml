<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.form.maintenance.usability</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="maintenance.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//app[@name='maintenance']" position="inside">
                <block title="Equipment Usability" name="usability">
                    <setting
                        string="Usability Validity Period"
                        help="Number of months the equipment stays usable after its latest passed maintenance result. Validity extends to the end of the target month (e.g. passed on 15 June with 13 months stays usable until 31 July of the following year)."
                    >
                        <field name="usability_grace_period_months" />
                        <span class="text-muted ms-1">months</span>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
