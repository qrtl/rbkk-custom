<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.form.maintenance.usability</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="maintenance.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//app[@name='maintenance']" position="inside">
                <block title="Equipment Usability" name="usability">
                    <setting
                        string="Usability Grace Period"
                        help="Number of months after the latest completed maintenance result during which the equipment stays usable."
                    >
                        <field name="usability_grace_period_months" />
                        <span class="text-muted ms-1">months</span>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
