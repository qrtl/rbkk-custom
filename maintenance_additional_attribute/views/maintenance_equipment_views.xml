<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="maintenance_equipment_view_form" model="ir.ui.view">
        <field name="name">maintenance.equipment.form</field>
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_view_form" />
        <!-- Applied after maintenance_equipment_usability's form view (priority 16),
             whose maintenance_exempt field this view relocates. Sibling views are
             applied in (priority, id) order, so without this the order would depend
             on which module happened to be installed first. -->
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <div name="button_box" position="after">
                <field
                    name="image_1920"
                    widget="image"
                    class="oe_avatar"
                    options="{'preview_image': 'image_128'}"
                />
            </div>
            <field name="active" position="after">
                <xpath
                    expr="//page[@name='product_information']//field[@name='serial_no']"
                    position="move"
                />
            </field>
            <xpath expr="//field[@name='category_id']" position="after">
                <field name="generic_name_id" />
                <field name="set_name" />
            </xpath>
            <field name="location" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <field name="location" position="after">
                <field name="location_id" />
                <field name="is_national_project" />
                <field
                    name="national_project_name"
                    invisible="not is_national_project"
                />
                <field name="is_fixed_asset" />
                <field name="fixed_asset_code" invisible="not is_fixed_asset" />
                <field name="is_gmp" />
                <field name="management_no" invisible="not is_gmp" />
            </field>
            <xpath expr="//field[@name='model']" position="after">
                <field name="manufacturer" />
                <field name="manufacturer_serial_no" />
                <field name="purchase_order_id" />
            </xpath>
            <field name="warranty_date" position="after">
                <field name="usable_temperature" />
                <field name="usable_humidity" />
            </field>
            <xpath expr="//page[@name='product_information']" position="after">
                <page string="Inspection" name="inspection">
                    <group>
                        <group name="inspection">
                            <field name="is_manufacturer_calibration" />
                            <field name="is_in_house_calibration" />
                            <field name="is_fluorocarbon_inspection" />
                        </group>
                    </group>
                </page>
            </xpath>
            <field name="maintenance_exempt" position="attributes">
                <attribute name="string">Inspection Exempt</attribute>
            </field>
            <xpath
                expr="//page[@name='inspection']//field[@name='is_manufacturer_calibration']"
                position="before"
            >
                <xpath expr="//field[@name='maintenance_exempt']" position="move" />
            </xpath>
            <xpath expr="//field[@name='effective_date']" position="after">
                <field name="acquisition_date" />
            </xpath>
        </field>
    </record>
    <record id="maintenance_equipment_view_list" model="ir.ui.view">
        <field name="name">maintenance.equipment.list</field>
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_view_tree" />
        <!-- Applied after the other extensions so that the columns they add can
             be moved, and so that the State and Validation Status columns that
             maintenance_equipment_tier_validation (if installed) adds right
             after the name end up between the two blocks below. -->
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <field name="name" position="before">
                <xpath expr="//field[@name='serial_no']" position="move" />
            </field>
            <field name="name" position="after">
                <xpath expr="//field[@name='usability_state']" position="move" />
                <field name="status" optional="show" />
                <field name="maintenance_team_id" optional="show" />
                <xpath expr="//field[@name='technician_user_id']" position="move" />
                <field name="location_id" optional="show" />
                <field name="is_gmp" optional="show" />
                <field name="management_no" optional="hide" />
                <field name="is_fixed_asset" optional="show" />
                <field name="fixed_asset_code" optional="hide" />
                <field name="acquisition_date" optional="show" />
                <field
                    name="maintenance_exempt"
                    string="Inspection Exempt"
                    optional="show"
                />
                <field name="is_manufacturer_calibration" optional="show" />
                <field name="is_in_house_calibration" optional="show" />
                <field name="is_fluorocarbon_inspection" optional="hide" />
            </field>
            <field name="employee_id" position="before">
                <field name="manufacturer" optional="hide" />
                <field name="model" optional="hide" />
                <field name="manufacturer_serial_no" optional="hide" />
                <field name="is_national_project" optional="hide" />
                <field name="national_project_name" optional="hide" />
            </field>
            <field name="employee_id" position="attributes">
                <attribute name="optional">hide</attribute>
            </field>
            <field name="department_id" position="attributes">
                <attribute name="optional">hide</attribute>
            </field>
            <field name="category_id" position="attributes">
                <attribute name="optional">hide</attribute>
            </field>
            <field name="category_id" position="after">
                <field name="generic_name_id" optional="hide" />
                <field name="set_name" optional="hide" />
                <field name="usable_temperature" optional="hide" />
                <field name="usable_humidity" optional="hide" />
            </field>
        </field>
    </record>
    <record id="maintenance_equipment_view_search" model="ir.ui.view">
        <field name="name">maintenance.equipment.search</field>
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_view_search" />
        <field name="arch" type="xml">
            <field name="category_id" position="after">
                <field name="generic_name_id" />
                <field name="location_id" />
                <field name="management_no" />
                <field name="fixed_asset_code" />
                <field name="manufacturer" />
                <field name="manufacturer_serial_no" />
            </field>
            <filter name="under_maintenance" position="after">
                <separator />
                <filter
                    name="fixed_asset"
                    string="Fixed Asset"
                    domain="[('is_fixed_asset', '=', True)]"
                />
                <filter name="gmp" string="GMP" domain="[('is_gmp', '=', True)]" />
                <filter
                    name="manufacturer_calibration"
                    string="Manufacturer Calibration"
                    domain="[('is_manufacturer_calibration', '=', True)]"
                />
                <filter
                    name="in_house_calibration"
                    string="In-house Calibration"
                    domain="[('is_in_house_calibration', '=', True)]"
                />
                <filter
                    name="fluorocarbon_inspection"
                    string="Fluorocarbon Inspection Target"
                    domain="[('is_fluorocarbon_inspection', '=', True)]"
                />
            </filter>
            <group position="inside">
                <filter
                    name="generic_name"
                    string="General Name"
                    domain="[]"
                    context="{'group_by': 'generic_name_id'}"
                />
                <filter
                    name="location"
                    string="Used in location"
                    domain="[]"
                    context="{'group_by': 'location_id'}"
                />
            </group>
        </field>
    </record>
</odoo>
