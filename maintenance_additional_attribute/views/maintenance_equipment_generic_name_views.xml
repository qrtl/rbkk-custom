<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="maintenance_equipment_generic_name_view_list" model="ir.ui.view">
        <field name="name">maintenance.equipment.generic.name.list</field>
        <field name="model">maintenance.equipment.generic.name</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name" />
                <field name="active" widget="boolean_toggle" />
            </list>
        </field>
    </record>
    <record id="maintenance_equipment_generic_name_view_search" model="ir.ui.view">
        <field name="name">maintenance.equipment.generic.name.search</field>
        <field name="model">maintenance.equipment.generic.name</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <filter
                    name="inactive"
                    string="Archived"
                    domain="[('active', '=', False)]"
                />
            </search>
        </field>
    </record>
    <record
        id="maintenance_equipment_generic_name_action"
        model="ir.actions.act_window"
    >
        <field name="name">General Names</field>
        <field name="res_model">maintenance.equipment.generic.name</field>
        <field name="view_mode">list</field>
    </record>
    <menuitem
        id="menu_maintenance_equipment_generic_name"
        name="General Names"
        parent="maintenance.menu_maintenance_configuration"
        action="maintenance_equipment_generic_name_action"
        sequence="90"
    />
</odoo>
