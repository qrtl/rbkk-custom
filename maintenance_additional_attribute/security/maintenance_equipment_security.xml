<odoo>
    <!-- The standard rules maintenance.equipment_rule_user and
         maintenance.equipment_request_rule_user only let an internal user see
         the equipment they follow and the requests they own, follow or are
         assigned to, which leaves the equipment register and the request list
         mostly empty for anybody who is not an equipment manager. Those rules
         are defined with noupdate="1", so instead of rewriting their domains we
         add permissive read rules: rules of the groups a user belongs to are
         combined with OR, and editing stays under the standard rules. -->
    <record id="equipment_rule_user_read_all" model="ir.rule">
        <field name="name">Users are allowed to read all equipment</field>
        <field name="model_id" ref="maintenance.model_maintenance_equipment" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]" />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="False" />
        <field name="perm_create" eval="False" />
        <field name="perm_unlink" eval="False" />
    </record>
    <record id="equipment_request_rule_user_read_all" model="ir.rule">
        <field name="name">Users are allowed to read all maintenance requests</field>
        <field name="model_id" ref="maintenance.model_maintenance_request" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]" />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="False" />
        <field name="perm_create" eval="False" />
        <field name="perm_unlink" eval="False" />
    </record>
</odoo>
