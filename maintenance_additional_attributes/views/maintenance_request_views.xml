<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="hr_equipment_request_view_form" model="ir.ui.view">
        <field name="name">maintenance.request.form.additional.attributes</field>
        <field name="model">maintenance.request</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_request_view_form" />
        <field name="arch" type="xml">
            <field name="close_date" position="attributes">
                <attribute name="readonly">0</attribute>
                <attribute name="invisible">0</attribute>
            </field>
            <xpath expr="//field[@name='schedule_date']" position="after">
                <field name="alert_period_months" />
            </xpath>
        </field>
    </record>
</odoo>
