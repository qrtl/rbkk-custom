<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form_analytic_plan_field" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.purchase</field>
        <field name="model">res.config.settings</field>
        <field
            name="inherit_id"
            ref="purchase.res_config_settings_view_form_purchase"
        />
        <field name="arch" type="xml">
            <xpath expr="//block[@name='purchase_setting_container']" position="inside">
                <setting
                    company_dependent="1"
                    string="Analytic Plan for Purchase Order Lines"
                    help="Select the analytic plan used for the analytic plan account field on purchase order lines."
                >
                    <field name="pol_analytic_plan_id" />
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
