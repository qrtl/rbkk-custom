<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="paperformat_acceptance_label" model="report.paperformat">
        <field name="name">A4 Portrait Acceptance Label Sheet</field>
        <field name="default" eval="False" />
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">0</field>
        <field name="margin_bottom">0</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="header_line" eval="False" />
        <field name="header_spacing">0</field>
        <field name="disable_shrinking" eval="True" />
        <field name="dpi">96</field>
    </record>

    <record id="stock_acceptance_label_report_action" model="ir.actions.report">
        <field name="name">Acceptance Label</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-pdf</field>
        <field
            name="report_name"
        >stock_acceptance_label.report_stock_acceptance_label</field>
        <field
            name="report_file"
        >stock_acceptance_label.report_stock_acceptance_label</field>
        <field name="paperformat_id" ref="paperformat_acceptance_label" />
        <field name="print_report_name">'Acceptance Labels'</field>
        <field name="binding_model_id" ref="stock.model_stock_picking" />
        <field name="binding_type">report</field>
    </record>
</odoo>
