#: model:ir.model.fields,field_description:stock_acceptance_label.field_res_company__acceptance_label_arrival_date_field_id
#: model:ir.model.fields,field_description:stock_acceptance_label.field_res_config_settings__acceptance_label_arrival_date_field_id
msgid "Arrival Date Field"
msgstr "入荷日フィールド"

#. module: stock_acceptance_label
