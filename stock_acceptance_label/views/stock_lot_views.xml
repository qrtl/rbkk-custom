<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="stock_lot_view_form" model="ir.ui.view">
        <field name="name">stock.lot.form</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_form" />
        <field name="arch" type="xml">
            <field name="ref" position="after">
                <field name="acceptance_number" />
            </field>
        </field>
    </record>

    <record id="stock_lot_view_list" model="ir.ui.view">
        <field name="name">stock.lot.list</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_tree" />
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="acceptance_number" optional="show" />
            </field>
        </field>
    </record>
</odoo>
