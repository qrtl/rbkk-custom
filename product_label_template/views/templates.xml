<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="product_label_reports">
        <t t-call="web.basic_layout">
            <div class="page">
                <t t-foreach="lots" t-as="lot">
                    <t t-call="product_label_template.basic_label_template">
                        <t
                            t-set="product_label"
                            t-value="lot.product_id.product_label_template_ids and lot.product_id.product_label_template_ids[0]"
                        />
                        <!-- FIXME: Serial number should be printed instead -->
                        <t t-set="qr_code" t-value="lot.product_id.barcode" />
                    </t>
                </t>
            </div>
        </t>
    </template>
    <template id="basic_label_template">
        <div t-if="product_label" t-att-style="product_label.get_label_layout_css()">
            <div t-att-style="product_label.get_label_css()">
                <div t-att-style="product_label.get_label_text_css()">
                    <span t-field="lot.ref" />
                    <br />
                    <span
                        t-field="lot.create_date"
                        t-options="{'format':'yyyy-MM-dd'}"
                    />
                    <br />
                    <span
                        t-field="lot.removal_date"
                        t-options="{'format':'yyyy-MM-dd'}"
                    />
                </div>
                <t t-if="product_label.with_qr_code">
                    <t t-set="qr_size" t-value="product_label.qr_code_size or 100" />
                    <img
                        t-att-src="'/report/barcode/?type=%s&amp;value=%s&amp;width=%s&amp;height=%s' % ('QR', quote_plus(qr_code or ''), qr_size, qr_size)"
                        t-att-style="product_label.get_qr_code_css()"
                    />
                </t>
            </div>
        </div>
    </template>
</odoo>
