<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="basic_label_template">
        <div t-if="product_label" t-att-style="product_label.get_label_layout_css()">
            <div t-att-style="product_label.get_label_css()">
                <div t-att-style="product_label.get_label_text_css()">
                    <t t-set="lot" t-value="serial.lot_id" />
                    <span t-field="lot.ref" />
                    <br />
                    <span
                        t-field="lot.date_produced"
                        t-options="{'format':'yyyy-MM-dd'}"
                    />
                    <br />
                    <span
                        t-field="lot.expiry_date"
                        t-options="{'format':'yyyy-MM-dd'}"
                    />
                </div>
                <t t-if="product_label.with_qr_code">
                    <img
                        t-att-src="'/report/barcode/?type=%s&amp;value=%s' % ('QR', quote_plus(serial.name or ''))"
                        t-att-style="product_label.get_qr_code_css()"
                    />
                </t>
                <t t-if="product_label.with_gs1_code">
                    <img
                        t-attf-src="data:image/png;base64,#{lot.gs1_image}"
                        t-att-style="product_label.get_gs1_code_css()"
                    />
                </t>
            </div>
        </div>
    </template>
</odoo>
