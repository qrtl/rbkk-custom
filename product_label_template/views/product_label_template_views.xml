<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="product_label_template_view_form" model="ir.ui.view">
        <field name="name">product.label.template.form</field>
        <field name="model">product.label.template</field>
        <field name="arch" type="xml">
            <form string="Product Label Templates">
                <sheet>
                    <group string="Main Attributes">
                        <group>
                            <field name="product_id" />
                            <field
                                name="product_template_attribute_value_ids"
                                widget="many2many_tags"
                            />
                            <field name="paperformat_id" />
                            <field name="coefficient" />
                            <field name="label_image" widget="image" />
                        </group>
                        <group>
                            <field name="label_width" />
                            <field name="label_height" />
                            <field name="label_ratio" invisible="1" />
                            <field name="label_width_margin" />
                            <field name="label_height_margin" />
                            <field name="with_qr_code" />
                            <field name="with_barcode" />
                        </group>
                    </group>
                    <group>
                        <group string="Lot Information">
                            <field name="font_size" />
                            <field name="width_padding_lot" />
                            <field name="height_padding_lot" />
                        </group>
                        <group string="QR Code" invisible="not with_qr_code">
                            <field name="qr_code_size" required="with_qr_code" />
                            <field name="qr_code_width_padding" />
                            <field name="qr_code_height_padding" />
                        </group>
                        <group string="Barcode" invisible="not with_barcode">
                            <field name="barcode_width" required="with_barcode" />
                            <field name="barcode_height" required="with_barcode" />
                            <field name="barcode_width_padding" />
                            <field name="barcode_height_padding" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="product_label_template_view_list" model="ir.ui.view">
        <field name="name">product.label.template.list</field>
        <field name="model">product.label.template</field>
        <field name="arch" type="xml">
            <list string="Label Templates" editable="top">
                <field name="product_id" />
                <field
                    name="product_template_attribute_value_ids"
                    widget="many2many_tags"
                />
                <field name="paperformat_id" />
                <field name="coefficient" />
                <field
                    name="label_image"
                    widget="image"
                    options="{'size': [200, 200]}"
                />
                <field name="label_width" />
                <field name="label_height" />
                <field name="label_ratio" column_invisible="1" />
                <field name="label_width_margin" />
                <field name="label_height_margin" />
                <field name="font_size" />
                <field name="width_padding_lot" />
                <field name="height_padding_lot" />
                <field name="with_qr_code" />
                <field name="with_barcode" />
            </list>
        </field>
    </record>
    <record id="product_label_template_view_search" model="ir.ui.view">
        <field name="name">product.label.template.search</field>
        <field name="model">product.label.template</field>
        <field name="arch" type="xml">
            <search string="Product Label Templates">
                <field name="product_id" />
                <field name="product_template_attribute_value_ids" />
                <group expand="0" string="Group By">
                    <filter
                        string="Product Template"
                        name="by_product_template"
                        domain="[]"
                        context="{'group_by': 'product_tmpl_id'}"
                    />
                    <filter
                        string="Product variant attribute"
                        name="by_product_attribute"
                        domain="[]"
                        context="{'group_by': 'product_template_attribute_value_ids'}"
                    />
                </group>
            </search>
        </field>
    </record>
    <record id="product_label_template_action" model="ir.actions.act_window">
        <field name="name">Product Label Templates</field>
        <field name="res_model">product.label.template</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_by_product_template': 1}</field>
    </record>
    <menuitem
        id="menu_product_label_template"
        action="product_label_template_action"
        parent="stock.menu_product_in_config_stock"
        sequence="100"
    />
</odoo>
