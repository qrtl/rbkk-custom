<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="ir_actions_report_view_form" model="ir.ui.view">
        <field name="name">ir.actions.report.form.plt</field>
        <field name="model">ir.actions.report</field>
        <field name="inherit_id" ref="base.act_report_xml_view" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='paperformat_id']" position="after">
                <field name="use_plt_paperformat" />
                <field
                    name="plt_paperformat_type"
                    invisible="not use_plt_paperformat"
                />
            </xpath>
        </field>
    </record>
</odoo>
