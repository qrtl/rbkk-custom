<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="product_normal_view_form" model="ir.ui.view">
        <field name="name">product.product.form.label.template</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Label Templates" name="label_templates">
                    <field name="product_label_template_ids">
                        <list string="Product Labels">
                            <field name="paperformat_id" />
                            <field
                                name="product_template_attribute_value_ids"
                                widget="many2many_tags"
                            />
                            <field
                                name="label_image"
                                widget="image"
                                options="{'size': [200, 200]}"
                            />
                            <field name="label_width" />
                            <field name="label_height" />
                            <field name="label_width_margin" />
                            <field name="label_height_margin" />
                            <field name="with_qr_code" />
                            <field name="with_barcode" />
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
