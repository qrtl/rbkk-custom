<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_product_form_label_template" model="ir.ui.view">
        <field name="name">view.product.form.label.template</field>
        <field name="model">product.product</field>
        <field name="mode">primary</field>
        <field name="priority" eval="5" />
        <field name="inherit_id" ref="product.product_template_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Label Templates">
                    <group>
                        <field
                            name="product_label_template_ids"
                            context="{'default_product_id': active_id}"
                            nolabel="1"
                        >
                            <tree string="Product Labels">
                                <field name="paperformat_id" />
                                <field
                                    name="label_image"
                                    widget="image"
                                    options="{'size': [200, 200]}"
                                />
                                <field name="label_width" />
                                <field name="label_height" />
                                <field name="label_width_margin" />
                                <field name="label_height_margin" />
                                <field name="font_family" />
                                <field name="with_qr_code" />
                                <field name="with_gs1_code" />
                            </tree>
                        </field>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
