<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="product_chemical_stock_view_list" model="ir.ui.view">
        <field name="name">product.chemical.stock.list</field>
        <field name="model">product.chemical.stock</field>
        <field name="arch" type="xml">
            <list create="false" edit="false">
                <field name="location_id" />
                <field name="substance_id" />
                <field name="cas_no" />
                <field name="product_tmpl_id" />
                <field name="quantity" />
                <field name="product_uom_id" />
                <field name="content_rate" />
                <field name="component_amount" sum="Total" />
                <field name="amount_uom_id" />
                <field name="uom_category_id" column_invisible="True" />
            </list>
        </field>
    </record>
    <record id="product_chemical_stock_view_search" model="ir.ui.view">
        <field name="name">product.chemical.stock.search</field>
        <field name="model">product.chemical.stock</field>
        <field name="arch" type="xml">
            <search>
                <field name="substance_id" />
                <field name="cas_no" />
                <field name="location_id" />
                <field name="product_tmpl_id" />
                <field name="amount_uom_id" />
                <filter
                    string="Aggregated Only"
                    name="aggregated"
                    domain="[('uom_category_id.chemical_uom_id', '!=', False)]"
                    help="Only amounts converted into a chemical aggregation unit, i.e. excluding count-managed products."
                />
                <group expand="0" string="Group By">
                    <filter
                        string="Amount UoM"
                        name="group_amount_uom"
                        context="{'group_by': 'amount_uom_id'}"
                    />
                    <filter
                        string="UoM Category"
                        name="group_uom_category"
                        context="{'group_by': 'uom_category_id'}"
                    />
                    <filter
                        string="Location"
                        name="group_location"
                        context="{'group_by': 'location_id'}"
                    />
                    <filter
                        string="Substance"
                        name="group_substance"
                        context="{'group_by': 'substance_id'}"
                    />
                    <filter
                        string="Product"
                        name="group_product"
                        context="{'group_by': 'product_tmpl_id'}"
                    />
                </group>
            </search>
        </field>
    </record>
    <record id="product_chemical_stock_action" model="ir.actions.act_window">
        <field name="name">Chemicals by Location</field>
        <field name="res_model">product.chemical.stock</field>
        <field name="view_mode">list</field>
        <!-- The amount unit has to be the outermost group, otherwise weight and
             volume amounts end up in the same subtotal. -->
        <field
            name="context"
        >{'search_default_group_amount_uom': 1, 'search_default_group_location': 1, 'search_default_group_substance': 1}</field>
    </record>
</odoo>
