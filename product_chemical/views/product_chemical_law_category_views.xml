<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="product_chemical_law_major_category_view_list" model="ir.ui.view">
        <field name="name">product.chemical.law.major.category.list</field>
        <field name="model">product.chemical.law.major.category</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle" />
                <field name="law_id" />
                <field name="name" />
            </list>
        </field>
    </record>
    <record id="product_chemical_law_major_category_view_form" model="ir.ui.view">
        <field name="name">product.chemical.law.major.category.form</field>
        <field name="model">product.chemical.law.major.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="bg-danger"
                        invisible="active"
                    />
                    <div class="oe_title">
                        <label for="name" />
                        <h1>
                            <field name="name" placeholder="Major Category" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="law_id" />
                            <field name="sequence" />
                        </group>
                        <group>
                            <field name="active" invisible="1" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Minor Categories" name="minor_categories">
                            <field name="minor_category_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle" />
                                    <field name="name" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="product_chemical_law_major_category_view_search" model="ir.ui.view">
        <field name="name">product.chemical.law.major.category.search</field>
        <field name="model">product.chemical.law.major.category</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="law_id" />
                <group expand="0" string="Group By">
                    <filter
                        string="Law"
                        name="group_law"
                        context="{'group_by': 'law_id'}"
                    />
                </group>
            </search>
        </field>
    </record>
    <record
        id="product_chemical_law_major_category_action"
        model="ir.actions.act_window"
    >
        <field name="name">Major Categories</field>
        <field name="res_model">product.chemical.law.major.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="product_chemical_law_minor_category_view_list" model="ir.ui.view">
        <field name="name">product.chemical.law.minor.category.list</field>
        <field name="model">product.chemical.law.minor.category</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle" />
                <field name="law_id" />
                <field name="major_category_id" />
                <field name="name" />
            </list>
        </field>
    </record>
    <record id="product_chemical_law_minor_category_view_form" model="ir.ui.view">
        <field name="name">product.chemical.law.minor.category.form</field>
        <field name="model">product.chemical.law.minor.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="bg-danger"
                        invisible="active"
                    />
                    <div class="oe_title">
                        <label for="name" />
                        <h1>
                            <field name="name" placeholder="Minor Category" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="major_category_id" />
                            <field name="law_id" readonly="1" />
                        </group>
                        <group>
                            <field name="sequence" />
                            <field name="active" invisible="1" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="product_chemical_law_minor_category_view_search" model="ir.ui.view">
        <field name="name">product.chemical.law.minor.category.search</field>
        <field name="model">product.chemical.law.minor.category</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="major_category_id" />
                <field name="law_id" />
                <group expand="0" string="Group By">
                    <filter
                        string="Law"
                        name="group_law"
                        context="{'group_by': 'law_id'}"
                    />
                    <filter
                        string="Major Category"
                        name="group_major"
                        context="{'group_by': 'major_category_id'}"
                    />
                </group>
            </search>
        </field>
    </record>
    <record
        id="product_chemical_law_minor_category_action"
        model="ir.actions.act_window"
    >
        <field name="name">Minor Categories</field>
        <field name="res_model">product.chemical.law.minor.category</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
