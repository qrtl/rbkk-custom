<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="product_chemical_location_amount_view_list" model="ir.ui.view">
        <field name="name">product.chemical.location.amount.list</field>
        <field name="model">product.chemical.location.amount</field>
        <field name="arch" type="xml">
            <list create="false" edit="false">
                <field name="location_id" />
                <field name="substance_id" />
                <field name="cas_no" />
                <field name="product_tmpl_id" />
                <field name="quantity" />
                <field name="product_uom_id" />
                <field name="content_rate" />
                <field name="component_amount" />
            </list>
        </field>
    </record>
    <record id="product_chemical_location_amount_view_search" model="ir.ui.view">
        <field name="name">product.chemical.location.amount.search</field>
        <field name="model">product.chemical.location.amount</field>
        <field name="arch" type="xml">
            <search>
                <field name="substance_id" />
                <field name="cas_no" />
                <field name="location_id" />
                <field name="product_tmpl_id" />
                <group expand="0" string="Group By">
                    <filter
                        string="Location"
                        name="group_location"
                        context="{'group_by': 'location_id'}"
                    />
                    <filter
                        string="Substance"
                        name="group_substance"
                        context="{'group_by': 'substance_id'}"
                    />
                    <filter
                        string="Product"
                        name="group_product"
                        context="{'group_by': 'product_tmpl_id'}"
                    />
                    <filter
                        string="Unit of Measure"
                        name="group_uom"
                        context="{'group_by': 'product_uom_id'}"
                    />
                </group>
            </search>
        </field>
    </record>
    <record id="product_chemical_location_amount_action" model="ir.actions.act_window">
        <field name="name">Chemicals by Location</field>
        <field name="res_model">product.chemical.location.amount</field>
        <field name="view_mode">list</field>
        <field
            name="context"
        >{'search_default_group_location': 1, 'search_default_group_substance': 2, 'search_default_group_uom': 3}</field>
    </record>
</odoo>
